# ============================================================
# CubeForge / Cubicase — .gitignore
# ============================================================

# Dependências
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
api/node_modules/
api/.wrangler/
api/dist/

# Build & Geração
/.next/
/out/
/build
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/
src-tauri/sidecars/**/*.exe

# Resto de instalação local de servidor Forge de teste (não é código-fonte)
src-tauri/libraries/
src-tauri/run.bat
src-tauri/run.sh
src-tauri/user_jvm_args.txt

# Config local do Claude Code (específica da máquina, não do projeto)
.claude/settings.local.json

# Logs
*.log

# Testing
/coverage

# IDE / OS
.DS_Store
*.pem
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets
.env*
network_session.json

# Cloudflare (Wrangler)
.wrangler/
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Planos de arquitetura (documentos internos)
plans/
