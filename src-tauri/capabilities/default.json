{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": ["-Command", {"validator":"[\\s\\S]*"}]
        },
        {
          "name": "tsnet-node",
          "sidecar": true,
          "args": ["--config", {"validator":"[\\s\\S]*"}]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "tsnet-node",
          "sidecar": true,
          "args": ["--config", {"validator":"[\\s\\S]*"}]
        }
      ]
    },
    "shell:default",
    "os:default",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPLOCALDATA/**/*", "recursive": true },
        { "path": "$DOCUMENT/**/*", "recursive": true },
        { "path": "$DOCUMENT/**", "recursive": false }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPLOCALDATA/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers", "recursive": false }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPLOCALDATA/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers", "recursive": false }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPLOCALDATA/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers", "recursive": false }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPLOCALDATA/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers/**/*", "recursive": true }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPLOCALDATA/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers/**/*", "recursive": true }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$DOCUMENT/CubicaseServers/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers", "recursive": false },
        { "path": "$HOME/**/*", "recursive": true }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPLOCALDATA/**/*", "recursive": true },
        { "path": "$DOCUMENT/CubicaseServers/**/*", "recursive": true }
      ]
    },
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://api.adoptium.net" },
        { "url": "https://api.cubeforge.dev" },
        { "url": "https://launchermeta.mojang.com" },
        { "url": "https://piston-meta.mojang.net" },
        { "url": "https://piston-meta.mojang.com" },
        { "url": "https://cubeforge-api.cubeforge.workers.dev" },
        { "url": "https://maven.minecraftforge.net" },
        { "url": "https://files.minecraftforge.net" },
        { "url": "https://neoapi.neoforged.net" },
        { "url": "https://maven.neoforged.net" },
        { "url": "https://meta.fabricmc.net" },
        { "url": "https://fill.papermc.io" },
        { "url": "https://fill-data.papermc.io" },
        { "url": "https://api.modrinth.com" }
      ]
    },
    "dialog:default",
    "updater:default"
  ]
}
