{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubicase",
  "version": "0.1.0",
  "identifier": "com.cubicase.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cubicase",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {},
    "os": {},
    "fs": {},
    "http": null,
    "dialog": null,
    "process": {},
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/FelipoArts/cubeforge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCNTBFNkYyODE3NkU1OTAKUldTUTVYYUI4dVpRVzhZK3NxT1U2T1NoaW5HYlBmTkFhSW5DVWlJRVlURUhya1NOSDVxbkh0OG4K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/tsnet-node"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
